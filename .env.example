# ─────────────────────────────────────────────────────────────
# Domus Tua — variabili d'ambiente (TEMPLATE)
#
# Copia questo file in `.env.local` (dev) e valorizzalo con i dati reali.
# `.env.local` NON va committato (già in .gitignore).
# In produzione: imposta le stesse chiavi su Vercel → Settings → Environment Variables.
#
# ⚠️ Nessun valore reale qui dentro: solo placeholder o default sicuri.
#    Le REALSMART_* e i secret sono SERVER-ONLY: mai prefisso NEXT_PUBLIC_.
#
# Ogni riga dice anche DOVE va impostata: [P] Production, [A] Anteprima (Preview), [L] locale.
# Dopo il deploy, `npm run verify:deploy -- <url>` dice quali mancano davvero — è quella la
# lista di cose da fare, non questo file.
#
# Dettagli: docs/env-and-deploy.md, docs/vercel-live-checklist.md, docs/lead-email.md
# ─────────────────────────────────────────────────────────────

# ─── Pubbliche (NEXT_PUBLIC_* → finiscono nel bundle client) ───

NEXT_PUBLIC_SITE_URL=                    # [P][A] OBBLIGATORIA. URL canonico (metadataBase, OG/canonical, sitemap, robots). Prod = dominio finale; Anteprima = URL Vercel. Senza, il sito si dichiara non indicizzabile.
NEXT_PUBLIC_USE_REALSMART=false          # [P] true = feed RealSmart live; false = fixture demo. In produzione deve essere true.
NEXT_PUBLIC_PREVIEW_BADGE=true           # [A][L] badge "contenuti in verifica". NON impostarla in Production: la verifica del deploy fallisce apposta.
NEXT_PUBLIC_ENABLE_I18N=false            # OPT-IN: "true" mostra il selettore lingua (it/en/fr/de/es). Default false = solo-italiano (consigliato per la prima presentazione). Vedi docs/client-demo-mode.md

# ─── RealSmart (gestionale = single source of truth immobili) ───
# Tutte le REALSMART_* sono SERVER-ONLY. Finché sono vuote, il sito gira sui mock.

REALSMART_FEED_URL=                      # [P] feed XML immobili. LIVE: default nel codice (env.ts) = https://www.gestim2002.it/portali/immobili_724.xml (URL pubblico, non segreto). Sovrascrivi qui solo se cambia.
REALSMART_API_KEY=                       # chiave/token per autenticare il feed o le API RealSmart
REALSMART_API_BASE=                      # base URL delle API REST RealSmart (scenario API)
REALSMART_FTP_HOST=                      # host FTP/SFTP se il feed è consegnato via file (scenario FTP)
REALSMART_FTP_USER=                      # utente FTP/SFTP
REALSMART_FTP_PASS=                      # password FTP/SFTP (secret)
REALSMART_FTP_PATH=                      # percorso remoto del file feed (es. /export/immobili.xml)
REALSMART_WEBHOOK_SECRET=                # segreto per verificare la firma dei webhook RealSmart (rivalidazione on-demand)

# ─── Contatti / lead ───
# Un lead del form contatti segue DUE strade indipendenti:
#  1) WhatsApp (client): al submit si apre wa.me precompilato. È il canale IMMEDIATO, NON una
#     consegna — è l'utente a premere invio. La UI dice "stiamo aprendo WhatsApp", non "inviato".
#  2) /api/lead (server): recapita il lead all'agenzia via EMAIL (Resend) e — se impostata —
#     lo salva anche su Google Sheet. Best-effort: senza email né sheet configurati risponde
#     ok:false e resta solo il WhatsApp.
# L'EMAIL del form riusa la STESSA configurazione dell'assistente: ASSISTANT_EMAIL_API_KEY,
# ASSISTANT_EMAIL_FROM, ASSISTANT_LEAD_EMAIL_TO (sezione Assistente più sotto). Un solo canale
# email per tutto il sito. NB: CONTACT_FORM_MODE e CONTACT_EMAIL_TO NON esistono più — il form
# non ha "modalità" e il destinatario è ASSISTANT_LEAD_EMAIL_TO.

SHEETS_WEBHOOK_URL=                      # [P] SERVER-ONLY, OPZIONALE. URL della Google Apps Script Web App che salva i lead su Google Sheet (persistenza IN PIÙ oltre all'email). Vuoto = nessun salvataggio su foglio, l'email resta. Setup: docs/form-backend-next-step.md

# ─── Provider AI (ricerca intelligente + assistente — vedi docs/ai-search.md) ───
# Un provider solo, condiviso dalle due feature (app/lib/ai/provider.ts).
# Senza NESSUNA chiave il sito funziona lo stesso: parser locale per la ricerca,
# risposta di fallback per la chat. Non è un errore, è il comportamento previsto.

GEMINI_API_KEY=                          # [P][A] SERVER-ONLY. Chiave Google Gemini: è il provider predefinito di ricerca e assistente. Chiave a consumo: tenerla server-only, mai NEXT_PUBLIC_.
ANTHROPIC_API_KEY=                       # [P][A] SERVER-ONLY. Chiave Anthropic: alternativa a Gemini per le stesse due feature.
AI_PROVIDER=                             # opzionale: "google" | "anthropic". Vuoto = Gemini se c'è GEMINI_API_KEY, altrimenti Claude. Serve a tornare indietro senza deploy di codice.
AI_SEARCH_MODEL=                         # opzionale, override del modello di parsing (default: gemini-2.5-flash su Google, claude-haiku-4-5-20251001 su Anthropic)
VOYAGE_API_KEY=                          # FACOLTATIVA. SERVER-ONLY. Embeddings da Voyage. Vuota NON spegne più il semantico: con GEMINI_API_KEY li fa Gemini. Serve solo per preferire Voyage, che è nato per il retrieval ma è una chiave e un fornitore in più.
VOYAGE_MODEL=                            # opzionale, override del modello embeddings Voyage (default: voyage-3.5-lite)
GEMINI_EMBEDDING_MODEL=                  # opzionale, override del modello embeddings Gemini (default: gemini-embedding-001)
EMBEDDINGS_DIMENSION=                    # opzionale, dimensione dei vettori (default: 512). Serve a confrontare le qualità quando si tara il semantico; in esercizio lasciare il default, che tiene la cache dei vettori sotto i limiti.

# ─── Assistente conversazionale (opt-in — vedi docs/assistant-architecture.md) ───
# Resta DISATTIVATO finché la configurazione di produzione non è completa (onda 9).

NEXT_PUBLIC_ENABLE_ASSISTANT=            # [A] "true" mostra la chat. Richiede un provider (GEMINI_API_KEY o ANTHROPIC_API_KEY): accenderla senza fa fallire la verifica del deploy. Vuoto/false = nascosto.
AI_ASSISTANT_MODEL=                      # opzionale, override del modello dell'assistente (default: gemini-3.6-flash su Google, claude-haiku-4-5-20251001 su Anthropic). gemini-3.5-flash-lite = risposte più rapide (p95 1339 ms invece di 2250) ma 93% di scelta dello strumento invece del 100%: vedi docs/assistant-architecture.md
ASSISTANT_RATE_LIMIT=                    # opzionale, turni di conversazione per IP ogni 10 minuti (default: 30)
ASSISTANT_LEAD_EMAIL_TO=                 # SERVER-ONLY. Destinatario delle richieste generate dall'assistente (default: immobiliare@domustua.it)
ASSISTANT_SEMANTIC_FLOOR=                # LASCIARE VUOTA. Vuota = retrieval semantico sulla knowledge base SPENTO, ed è la configurazione voluta: `npm run calibrate:semantic` (2026-08-06, gemini-embedding-001) ha misurato che le domande fuori tema somigliano alle voci quanto quelle pertinenti (0.667 contro 0.550), e che nemmeno una regola relativa le separa. Accenderlo peggiorerebbe l'assistente. Non ha un default apposta: scrivere un numero qui significa "ho rimisurato". Vedi docs/assistant-knowledge.md
ASSISTANT_EMAIL_API_KEY=                 # SERVER-ONLY. Chiave del provider email (Resend). Vuota = canale email non configurato: l'assistente NON finge di aver inviato, WhatsApp e telefono restano attivi.
RATE_LIMIT_REDIS_URL=                    # SERVER-ONLY. Endpoint REST Redis (Upstash o compatibile) per un rate limit CONDIVISO tra le istanze. Vuoto = contatore in-memory per-istanza, best-effort. Vedi docs/assistant-security.md
RATE_LIMIT_REDIS_TOKEN=                  # SERVER-ONLY. Token del medesimo endpoint.
ASSISTANT_EMAIL_FROM=                    # Mittente delle richieste (default: assistente@domustua.it). Deve essere su un dominio verificato presso il provider, altrimenti l'invio viene rifiutato.

# ─── Embed di terze parti (recensioni / social) ───

TRUSTINDEX_WIDGET_URL=                   # [P] URL/script del widget recensioni Trustindex. Il widget si carica SOLO dopo il consenso cookie (docs/reviews-integration.md).
INSTAGRAM_WIDGET_URL=                    # URL/embed del feed Instagram

# ─── Impostate da Vercel, non da te ───
# VERCEL_ENV            production | preview | development  → /api/health lo espone come "environment"
# VERCEL_GIT_COMMIT_SHA commit in esecuzione                → /api/health lo espone accorciato come "commit"
#
# Servono a `npm run verify:deploy`: è così che si scopre che l'ambiente sta ancora servendo
# un deploy vecchio, che è il modo più comune di perdere un pomeriggio.

# ─── Rimosse, e non devono tornare ───
# CONTACT_FORM_MODE, CONTACT_EMAIL_TO: il form contatti non ha una "modalità" e il destinatario
# email è ASSISTANT_LEAD_EMAIL_TO. Erano documentate ma il codice non le leggeva più (dead vars).
# La matrice completa delle capacità di consegna lead è in docs/lead-delivery.md; /api/health la
# riporta in modo veritiero (integrations.leadDelivery). Un test copre le combinazioni:
# app/lib/__tests__/lead.test.ts.
