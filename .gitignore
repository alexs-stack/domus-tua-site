# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (i .env reali NON si committano; il template .env.example sì)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# asset di lavoro non necessari nel repo
/_assets_raw
/public/images/reali/yt

# Materiale di studio/reverse engineering: vive solo in locale, mai nel repo
# (contiene asset di riferimento di terzi che non vanno ridistribuiti).
/reverse-engineering

# dati lingua tesseract scaricati da scripts/detect-sold.ts (rigenerabili)
*.traineddata

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache

# Report delle eval (generati: npm run eval, npm run eval:search).
# Fuori dal repository per lo stesso motivo di sempre: un report committato invecchia in
# silenzio e qualcuno ci decide sopra credendolo attuale.
eval-report.md
eval-search-report.md

# Lighthouse CI
/.lighthouseci/

# Impeccable: cache locale del design hook (la config condivisa si committa)
.impeccable/hook.cache.json

# Materiale di studio temporaneo (mai importato, mai spedito)
_refs/

# Screenshot di riferimento della wave "parità mobile" (scripts/mobile-shots.ts,
# scripts/mobile-filmstrip.ts). Sono ~90 MB di PNG a pagina intera: servono a
# confrontare un prima e un dopo sulla propria macchina, non a stare in un
# repository — e una fotografia committata invecchia in silenzio, come i report
# delle eval qui sopra. Si rigenerano con un comando.
/docs/shots/

# Sonde usa-e-getta della wave "parità mobile" (probe di misura scritti in
# radice per poter risolvere @playwright/test, e cancellati subito dopo).
.dt-*.mjs

# Report generati dall'audit contenuti (artefatti CI, non versionati)
reports/
